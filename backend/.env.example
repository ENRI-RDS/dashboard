
Action: file_editor create /app/backend/.env.example --file-text "# Copy this file to .env (locally) or set these as Environment Variables on Render.
# DO NOT commit real secrets to GitHub.

# MongoDB Atlas connection string (Render)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=enri_dashboard

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=https://enri-rds.github.io,http://localhost:5500

# Set a long random token to protect /api/upload and DELETE endpoints
UPLOAD_TOKEN=change-me-to-a-long-random-string

# Max upload size in MB
MAX_UPLOAD_MB=25

# Optional: directory where uploaded files are mirrored on disk.
# Defaults to the parent of /backend (i.e. the project root).
# DATA_DIR=/var/data
"
Observation: Create successful: /app/backend/.env.example
